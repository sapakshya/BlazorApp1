@page "/inventory/{Id:int}"

@using BlazorApp1.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<h3>Inventory Item Details</h3>

@if (item is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@item.Name</dd>
        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@item.Quantity</dd>
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@item.Description</dd>
    </dl>
    <a class="btn btn-secondary" href="/inventory/edit/@item.Id">Edit</a>
    <a class="btn btn-link" href="/inventory">Back to list</a>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private InventoryItem? item;

    // OnParametersSetAsync runs when the route parameter (Id) is set or changed
    protected override async Task OnParametersSetAsync()
    {
        item = await Db.InventoryItems!.FindAsync(Id);
    }
}
