@page "/inventory/create"

@using BlazorApp1.Data
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<h3>Create Inventory Item</h3>

<EditForm Model="item" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="mb-3">
        <InputText @bind-Value="item.Name" class="form-control" placeholder="Name" />
    </div>
    <div class="mb-3">
        <InputNumber @bind-Value="item.Quantity" class="form-control" />
    </div>
    <div class="mb-3">
        <InputTextArea @bind-Value="item.Description" class="form-control" />
    </div>
    <button class="btn btn-primary">Save</button>
</EditForm>

@code {
    private InventoryItem item = new();

    protected override void OnInitialized()
    {
        // OnInitialized is synchronous and suitable for lightweight setup
        item.Quantity = 0;
    }

    private async Task Save()
    {
        item.CreatedAt = DateTime.UtcNow;
        Db.InventoryItems!.Add(item);
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/inventory");
    }
}
