<div class="border rounded p-3">
    <p class="text-muted">Started at @StartedAt</p>
    <p>
        This sample component shows the current count and works only when the page is rendered interactively.
    </p>
    <button class="btn btn-primary" @onclick="IncrementCount">Increment</button>
    <span class="ms-2 fw-bold">@CurrentCount</span>
</div>

@code {
    private int CurrentCount;
    private string StartedAt = DateTime.UtcNow.ToString("o");

    private void IncrementCount()
    {
        CurrentCount++;
    }
}
